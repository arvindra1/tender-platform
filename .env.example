# Application Settings
APP_NAME="IndicTender Platform - CPPP Public Intelligence"
HOST=0.0.0.0
PORT=8000
DEBUG=false

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
DB_NAME=indic_tenders
AUTO_FALLBACK_MOCK_DB=true

# Safe Public Access Crawler Settings
# Adheres strictly to legal & safe public access: zero CAPTCHA bypassing, polite headers
CPPP_BASE_URL="https://eprocure.gov.in/eprocure/app"
CPPP_ACTIVE_TENDERS_URL="https://eprocure.gov.in/eprocure/app?page=FrontEndTendersByOrganisation&service=page"
USER_AGENT="IndicTenderPlatform/1.0 (+https://github.com/indic-tender/crawler; open-public-data-initiative)"
SAFE_REQUEST_DELAY_SEC=1.5
SAFE_TIMEOUT_SEC=15.0
SAFE_MAX_RETRIES=3
